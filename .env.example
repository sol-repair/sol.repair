# Solana network to point the app at.
# Allowed values: localhost | devnet | mainnet-beta | testnet
# Default if unset or invalid: devnet
#
# The NEXT_PUBLIC_ prefix is required: this value is read in the browser
# bundle, and Next.js only exposes env vars to the browser with that prefix.
#
# DO NOT switch this to mainnet-beta until the full flow has been tested
# end-to-end on a test network with a throwaway wallet. See docs/SPEC.md.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional: override the RPC endpoint (e.g. a dedicated Helius/QuickNode URL).
# If unset, the public Solana endpoint for the active network is used.
# Must be prefixed with NEXT_PUBLIC_ so it is available in the browser.
# NEXT_PUBLIC_RPC_ENDPOINT=https://devnet.helius-rpc.com/?api-key=your-key
