# Solana network to point the app at.
# Allowed values: localhost | devnet | mainnet-beta | testnet
# Default if unset or invalid: devnet
#
# The NEXT_PUBLIC_ prefix is required: this value is read in the browser
# bundle, and Next.js only exposes env vars to the browser with that prefix.
#
# DO NOT switch this to mainnet-beta until the full flow has been tested
# end-to-end on a test network with a throwaway wallet.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional: dedicated RPC endpoints, as an ordered comma-separated list per
# network. The first entry is the primary; the rest are preferred failover
# targets. Per-call failover is not implemented yet, so today the list
# defines the order deployments prefer and the public endpoint stays the
# built-in safety net. Malformed entries are ignored, and each network
# reads only its own list, so a devnet build can never be pointed at
# mainnet. Must be prefixed with NEXT_PUBLIC_ so they reach the browser.
# NEXT_PUBLIC_MAINNET_RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=your-key,https://solana-mainnet.g.alchemy.com/v2/your-key
# NEXT_PUBLIC_DEVNET_RPC_ENDPOINTS=https://solana-devnet.g.alchemy.com/v2/your-key

# Optional: the older single-endpoint form for the MAINNET build only.
# Still supported; the per-network list variables above are the preferred
# shape. If unset, the public Solana endpoint for the active network is
# used. Devnet and localhost always use the public endpoints, so this can
# never redirect a devnet build at mainnet.
# NEXT_PUBLIC_MAINNET_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=your-key
